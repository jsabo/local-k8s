#cloud-config
---
package_update: true
package_upgrade: true

users:
  # Default multipass user; passwordless sudo for automation.
  - name: ubuntu
    sudo: ['ALL=(ALL) NOPASSWD:ALL']
    ssh-authorized-keys:
      - ${ssh_key}
    lock-passwd: true
    shell: /bin/bash

# SSH keys only; no passwords and no root login.
ssh_pwauth: false
disable_root: true

packages:
  # Base deps + container runtime.
  - apt-transport-https
  - ca-certificates
  - curl
  - gpg
  - containerd

write_files:
  # Kernel modules required for Kubernetes networking.
  - path: /etc/modules-load.d/k8s.conf
    owner: root:root
    permissions: '0644'
    content: |
      overlay
      br_netfilter

  # Sysctls required by kube-proxy/CNI for forwarding and bridged traffic.
  - path: /etc/sysctl.d/k8s.conf
    owner: root:root
    permissions: '0644'
    content: |
      net.bridge.bridge-nf-call-iptables  = 1
      net.bridge.bridge-nf-call-ip6tables = 1
      net.ipv4.ip_forward                 = 1

  # Kubernetes audit policy:
  # - Default to Metadata (safe baseline).
  # - Capture most writes at RequestResponse for “who changed what”.
  # - Drop common high-volume noise (health/discovery, watch/events, leases, read chatter).
  # - Drop selected controller/operator reconcile loops that spam updates/patches.
  # - Never log Secret/ConfigMap contents (Metadata only).
  # - Never log bearer tokens: keep TokenReview + TokenRequest at Metadata (no request/response bodies).
  - path: /etc/kubernetes/audit-policy.yaml
    owner: root:root
    permissions: '0644'
    content: |
      ${audit_policy}

  # kubeadm config: rendered by Taskfile via envsubst before VM launch.
  - path: /etc/kubernetes/kubeadm-config.yaml
    owner: root:root
    permissions: '0644'
    content: |
      ${kubeadm_config}

runcmd:
  # Kernel + sysctl setup.
  - [ modprobe, overlay ]
  - [ modprobe, br_netfilter ]
  - [ sysctl, --system ]

  # Kubernetes requires swap off.
  - [ swapoff, -a ]
  - sed -i '/ swap / s/^\(.*\)$/#\1/g' /etc/fstab

  # Install Kubernetes packages from pkgs.k8s.io (versioned by ${kubernetes_version}).
  - [ mkdir, -p, -m, "755", /etc/apt/keyrings ]
  - bash -c "curl -fsSL https://pkgs.k8s.io/core:/stable:/v${kubernetes_version}/deb/Release.key | gpg --dearmor -o /etc/apt/keyrings/kubernetes-apt-keyring.gpg"
  - bash -c "echo 'deb [signed-by=/etc/apt/keyrings/kubernetes-apt-keyring.gpg] https://pkgs.k8s.io/core:/stable:/v${kubernetes_version}/deb/ /' > /etc/apt/sources.list.d/kubernetes.list"
  - apt-get update
  - apt-get install -y kubelet kubeadm kubectl
  - apt-mark hold kubelet kubeadm kubectl

  # Configure containerd for kubelet (systemd cgroups + pinned pause image).
  - mkdir -p /etc/containerd
  - bash -c "containerd config default > /etc/containerd/config.toml"
  - sed -i 's/SystemdCgroup = false/SystemdCgroup = true/' /etc/containerd/config.toml
  - sed -i -E 's#(^[[:space:]]*sandbox_image[[:space:]]*=[[:space:]]*\").*(\"$)#\1registry.k8s.io/pause:3.10.1\2#' /etc/containerd/config.toml
  - systemctl enable containerd
  - systemctl restart containerd

