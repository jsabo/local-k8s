apiVersion: gateway.networking.k8s.io/v1
kind: Gateway
metadata:
  name: ${gateway_name}
  namespace: ${gateway_ns}
  labels:
    app.kubernetes.io/part-of: nginx-gateway-fabric
spec:
  # NGINX Gateway Fabric installs a GatewayClass named "nginx" by default.
  # (configurable in NGF, but "nginx" is the default expectation)
  gatewayClassName: ${gateway_class}
  listeners:
    - name: http
      protocol: HTTP
      port: 80
      allowedRoutes:
        namespaces:
          from: All
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: headlamp
  namespace: ${headlamp_ns}
  labels:
    app.kubernetes.io/part-of: headlamp
spec:
  parentRefs:
    - name: ${gateway_name}
      namespace: ${gateway_ns}
      sectionName: http
  hostnames:
    - ${headlamp_host}
  rules:
    - backendRefs:
        - name: ${headlamp_svc}
          port: 80
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: whisker
  namespace: ${whisker_ns}
  labels:
    app.kubernetes.io/part-of: calico-whisker
spec:
  parentRefs:
    - name: ${gateway_name}
      namespace: ${gateway_ns}
      sectionName: http
  hostnames:
    - ${whisker_host}
  rules:
    - backendRefs:
        - name: whisker
          port: 8081
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: whisker-gateway-allow
  namespace: ${whisker_ns}
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/name: whisker
  policyTypes:
    - Ingress
  ingress:
    - from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: ${gateway_ns}
      ports:
        - protocol: TCP
          port: 8081

